{
  "name": "sigecat-api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "engines": { "node": ">=22 <23" },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "start": "npm run build && func start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --config ../eslint.config.js .",
    "verificar-migraciones": "node scripts/verificar-migraciones.mjs",
    "test": "jest --runInBand",
    "test:rapido": "jest --runInBand --selectProjects unit",
    "test:integracion": "jest --runInBand --selectProjects integracion",
    "migrar": "tsx scripts/migrar.ts",
    "configurar:roles": "tsx scripts/configurar-roles.ts",
    "sembrar:demo": "tsx scripts/sembrar-demo.ts",
    "crear:administracion": "tsx scripts/crear-administracion-inicial.ts"
  },
  "dependencies": {
    "@azure/functions": "^4.11.0",
    "@azure/storage-blob": "^12.30.0",
    "jose": "^5.10.0",
    "pg": "^8.16.3",
    "uuid": "^11.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.6",
    "esbuild": "^0.25.12",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.5",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3"
  }
}
