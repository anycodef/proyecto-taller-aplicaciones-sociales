{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "compartido/**/*.ts",
    "bd/**/*.ts",
    "scripts/**/*.ts",
    "pruebas-e2e/**/*.test.ts"
  ],
  "exclude": ["node_modules"]
}
