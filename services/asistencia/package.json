{
  "name": "sigecat-asistencia",
  "version": "1.0.0",
  "description": "SIGECAT — microservicio Asistencia: sesiones, registros y señal de riesgo",
  "private": true,
  "main": "dist/main.js",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^20.19.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0"
  }
}
